<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#F5F5F5">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="אדם שמעורר בי השראה"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp" />

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/elon_musk"
        android:layout_marginBottom="50px"
        android:contentDescription="תמונת הדמות" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="אילון מאסק"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#23609D"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="יזם, ממציא ומייסד SpaceX ו-Tesla "
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="למה בחרתי בו?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"
            android:gravity="right"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="בחרתי באילון מאסק כי הוא מייצג חשיבה פורצת דרך אומץ והתמדה. הוא לא מפחד לקחת סיכונים ענקיים במקום שבו שאחרים נכשלו והצליח להפוך רעיונות שנראו כמו דמיון מודרך כמו חלליות לשימוש חוזר ומכוניות חשמליות מתקדמות למציאות. הסיפור שלו מלמד אותי לא להסס לקחת סיכונים ולעבוד קשה כדי להגשים את המטרות שלי."
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</LinearLayout>