<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- כותרת ראשית -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="להיות ישראלי"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#0038B8"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- תמונה מרכזית -->
    <ImageView
        android:id="@+id/israelImageView"
        android:layout_width="200dp"
        android:layout_height="140dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/israelflag"
        android:scaleType="centerCrop"
        android:contentDescription="סמל או דגל המייצגים את ישראל"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- טקסט תיאור -->
    <TextView
        android:id="@+id/descTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="להיות ישראלי זה להרגיש בבית בכל מקום, לחגוג יחד, להתנדב בעת צרה, ולחלוק תרבות עשירה המשלבת מסורת עם חדשנות ויצירתיות."
        android:textSize="16sp"
        android:textColor="#333333"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/israelImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כפתור פעולה -->
    <Button
        android:id="@+id/actionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שתף את התחושה שלך"
        android:textSize="16sp"
        android:backgroundTint="#0038B8"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/descTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>